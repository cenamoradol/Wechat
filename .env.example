# ============================================
# === Variables REQUERIDAS para producción ===
# ============================================

# === App ===
# URL pública de tu deploy. Para Vercel: https://wechat-tu-usuario.vercel.app
# Esto se usa para construir URLs de webhooks y redirect_uri de OAuth.
NEXT_PUBLIC_APP_URL=https://wechat.tu-dominio.com
NEXT_PUBLIC_APP_NAME=Wechat

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Cifrado (32 bytes base64) ===
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=<base64-de-32-bytes>

# === Meta ===
META_APP_ID=<id-real>
META_APP_SECRET=<secret-real>
NEXT_PUBLIC_META_APP_ID=<id-real-mismo>
# Opcional: solo si usas Embedded Signup v4
NEXT_PUBLIC_META_CONFIG_ID=<config-id-real>
# Auto-derivado si está vacío: ${NEXT_PUBLIC_APP_URL}/api/oauth/meta/callback
NEXT_PUBLIC_META_REDIRECT_URI=

# === Webhooks (elige cualquier string) ===
META_WEBHOOK_VERIFY_TOKEN=<string-que-tu-elijas>

# ============================================
# === Variables OPCIONALES ===
# ============================================

# Protege el endpoint de cron (futuro)
CRON_SECRET=<string>

# AI: si no las pones aquí, los usuarios pueden meterlas en /settings/ai
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...